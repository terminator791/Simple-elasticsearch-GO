# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce

# Elasticsearch configuration
ES_HOST=http://localhost:9200

# Server configuration
SERVER_PORT=8080

# JWT configuration
